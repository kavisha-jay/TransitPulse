# TransitPulse Environment Configuration

# Project & Environment
PROJECT_NAME=TransitPulse
ENV=development
LOG_LEVEL=INFO

# Transit API Credentials
TRANSIT_API_KEY=your_gtfs_rt_api_key_here
TRANSIT_API_BASE_URL=https://api.transit.example.com
GTFS_STATIC_URL=https://static.transit.example.com/gtfs.zip

# Storage & Data Lake Paths
DATA_DIR=./data
RAW_LANDING_DIR=./data/raw_landing
DELTA_WAREHOUSE_DIR=./data/delta_warehouse

# MinIO / S3 Object Storage Settings
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=transitpulse-lakehouse

# Database Settings (PostgreSQL / TimescaleDB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transitpulse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# PySpark & Spark Driver Config
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g
DELTA_PACKAGE_VERSION=3.1.0

# dbt Configuration
DBT_PROFILES_DIR=./src/analytics
DBT_TARGET=dev
